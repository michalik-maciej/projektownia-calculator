{
  "name": "@projektownia-calculator/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --include \"../../domain/src/**/*.ts\" --include \"../../schemas/src/**/*.ts\" src/server.ts",
    "build": "prisma generate && tsc -b",
    "start": "node dist/bootstrap.js",
    "migrate:deploy": "prisma migrate deploy",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "typecheck": "prisma generate && tsc -b"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.2.3"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "prisma": "^5.22.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "5.9.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts",
    "schema": "prisma/schema.prisma"
  }
}
